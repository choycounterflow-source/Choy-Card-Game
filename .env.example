# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Render, set this under Service > Environment > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, PWA install prompts, and share URLs.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Optional server-side GitHub Personal Access Token (repo contents write scope)
# Enables 1-click "Commit & Sync to GitHub" for the Choy Card Game repo inside Admin Secret Studio.
GITHUB_TOKEN=""

# RENDER_DEPLOY_HOOK_URL: Optional server-side Render Deploy Hook URL
# Enables 1-click "Trigger Render Deploy" directly inside Admin Secret Studio.
RENDER_DEPLOY_HOOK_URL=""
